# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.uv/

# Data warehouse & downloaded sources (regenerated by the pipeline)
data/*.duckdb
data/*.duckdb.wal
data/raw/
# Publishable artifact built by `just export-data`; it lives in GitHub releases
data/export/
# Parquet archive built by `just lake`; regenerated from the warehouse
data/lake/
*.csv
!dbt/seeds/*.csv

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# dlt
.dlt/secrets.toml
**/.dlt/pipelines/

# Dagster instance: run/event storage, compute logs (DAGSTER_HOME).
# The checked-in dagster.yaml is config; everything beside it is state.
.dagster/*
!.dagster/dagster.yaml
.tmp_dagster_home_*/

# Evidence
reports/.evidence/
reports/build/
node_modules/

# marimo
__marimo__/
